{
  "manifest_version": 3,
  "name": "Warera Tactical",
  "short_name": "Warera Tactical",
  "version": "0.1.3",
  "description": "Read-only WarEra companion with battle estimates, market insights, company stats and configurable opportunity radars.",
  "icons": {
    "16": "assets/icons/icon-16.png",
    "32": "assets/icons/icon-32.png",
    "48": "assets/icons/icon-48.png",
    "128": "assets/icons/icon-128.png"
  },
  "permissions": [
    "storage",
    "alarms",
    "notifications"
  ],
  "host_permissions": [
    "https://*.warera.io/*",
    "https://gateway.warerastats.io/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://app.warera.io/*",
        "https://warera.io/*"
      ],
      "js": [
        "shared/passive_cache.js",
        "content/battle_responses.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://app.warera.io/*",
        "https://warera.io/*"
      ],
      "js": [
        "shared/features.js",
        "shared/domain.js",
        "locales/es.js",
        "i18n.js",
        "content/ui.js",
        "content/api.js",
        "shared/passive_cache.js",
        "content/passive_cache.js",
        "content/observer.js",
        "content/modules/market.js",
        "content/modules/market_undercut.js",
        "content/modules/battle.js",
        "content/modules/spy_xray.js",
        "content/modules/company_advisor.js",
        "content/modules/net_salary.js",
        "content/modules/bounty_radar.js",
        "content/modules/loot_radar.js",
        "content/modules/country_builds.js",
        "content/modules/combat_math.js",
        "content/main.js"
      ],
      "css": [
        "content/styles.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://app.warera.io/*", "https://warera.io/*"],
      "js": ["content/contracts.js", "content/api.js", "shared/passive_cache.js", "content/passive_cache.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "Warera Tactical",
    "default_icon": {
      "16": "assets/icons/icon-16.png",
      "32": "assets/icons/icon-32.png",
      "48": "assets/icons/icon-48.png",
      "128": "assets/icons/icon-128.png"
    },
    "default_popup": "popup.html"
  }
}
